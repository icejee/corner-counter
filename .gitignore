# Node modules — never commit these (Render installs them during build)
node_modules/

# Build artifacts
dist/

# Large production ZIP (can be regenerated)
*.zip

# Scratch / test files (not needed on server)
scratch/

# Playwright test output
test-results/
playwright-report/

# System files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (keep secrets out of git)
.env
.env.local
.env.production
